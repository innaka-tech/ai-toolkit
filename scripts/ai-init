#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/ai-lib"

TARGET_DIR="${1:-$PWD}"
ROOT="$(ai_find_project_root "$TARGET_DIR")"
DOCS_DIR="$(ai_docs_dir "$ROOT")"
TASKS_DIR="$(ai_tasks_dir "$ROOT")"
CONFIG_DIR="$ROOT/.ai-toolkit"
CONFIG_FILE="$(ai_local_config_file "$ROOT")"
DEFAULT_BRANCH="$(ai_detect_default_branch "$ROOT")"
PROJECT_NAME="$(basename "$ROOT")"
NOW="$(ai_now_utc)"

mkdir -p "$DOCS_DIR" "$TASKS_DIR" "$CONFIG_DIR"

AGENTS_FILE="$(ai_agents_file "$ROOT")"
AI_PROTOCOL_START="<!-- ai-toolkit:protocol:start -->"
AI_PROTOCOL_END="<!-- ai-toolkit:protocol:end -->"

# OpenCode and several other coding agents discover AGENTS.md automatically,
# but do not recursively read arbitrary docs/ folders. Keep the canonical
# protocol here and make it safe to apply to existing AGENTS.md files.
if ! grep -Fq "$AI_PROTOCOL_START" "$AGENTS_FILE" 2>/dev/null; then
  cat >> "$AGENTS_FILE" <<EOF

$AI_PROTOCOL_START
## Shared AI project context (ai-toolkit)

Before making meaningful changes, read these repository-local files:

- \`docs/ai/project-context.md\` — project purpose, stack, constraints
- \`docs/ai/operating-model.md\` — lifecycle, goals, and source-of-truth rules
- \`docs/ai/goals.md\` — goal/sub-goal hierarchy, success criteria, and status
- \`docs/ai/application-map.md\` — verified application surfaces and gaps
- \`docs/ai/current-task.md\` — active objective and next steps
- \`docs/ai/handoff.md\` — latest work handed off by another agent
- \`docs/ai/knowledge.md\` — durable findings discovered while completing tasks
- \`docs/ai/next-tasks.md\` — evidence-based suggestions for the next task
- \`docs/ai/decisions.md\` — durable architecture/product decisions
- \`ai-state.json\` — machine-readable project state, when present

**ENGINE STANDARD (WAJIB — dari ~/.ai-toolkit/conventions/):**
- \`STANDARD_DEVELOPMENT.md\` — task lifecycle (5 stage + bug hunt loop), rotasi fokus, bukti per task, grounding rules anti-halusinasi, onboarding checklist. Berlaku SEMUA project.

Keep the files current while working. Update \`docs/ai/current-task.md\` at
start/close, append important handoffs to \`docs/ai/handoff.md\`, and record
durable decisions and newly discovered project knowledge in
\`docs/ai/decisions.md\` and \`docs/ai/knowledge.md\`. Every completed task must
call \`ai-close --knowledge "…"\` with findings about code, infra, CI/CD,
operations, constraints, bugs, or validation—even when the finding is that no
new durable knowledge was discovered. Treat these files as the
project's shared source of truth across Codex, OpenCode, Claude, and other AI
tools. Use \`.ai-toolkit/project.env\` for automation/deploy settings.
$AI_PROTOCOL_END
EOF
fi

STATE_FILE="$ROOT/ai-state.json"
if [ ! -f "$STATE_FILE" ]; then
  cat > "$STATE_FILE" <<EOF
{
  "version": 1,
  "last_session": "$NOW",
  "context": "$PROJECT_NAME — update this summary in docs/ai/project-context.md",
  "modules": {},
  "bugs_found": [],
  "progress": []
}
EOF
fi

if [ ! -f "$DOCS_DIR/project-context.md" ]; then
  cat > "$DOCS_DIR/project-context.md" <<EOF
# Project Context

Project: $PROJECT_NAME
Project Root: $ROOT
Initialized At: $NOW
Updated At: $NOW

## Summary
Describe what this project is for.

## Stack
- Fill in primary languages, frameworks, and infrastructure.

## Constraints
- Note hard constraints, rules, and non-goals.

## Conventions
- Record coding conventions, architecture patterns, and deployment rules.
EOF
fi

if [ ! -f "$DOCS_DIR/current-task.md" ]; then
  cat > "$DOCS_DIR/current-task.md" <<EOF
# Current Task

Status: IDLE
Task ID: none
Started At: n/a
Updated At: $NOW
Project Root: $ROOT

## Objective
No active task.

## Files Involved
- None yet

## Next Steps
- Define the first task

## Risks
- None recorded

## Validation
- Not run
EOF
fi

if [ ! -f "$DOCS_DIR/goals.md" ]; then
  cat > "$DOCS_DIR/goals.md" <<'EOF'
# Goals & Sub-goals

Use this file as the human-readable source of truth for project outcomes.
Keep each sub-goal independently actionable and link active tasks to a goal
and sub-goal in `docs/ai/current-task.md`.

## Goal G-001 — Define the project outcome

- Status: PLANNED
- Owner: TBD
- Success criteria:
  - TBD
- Non-goals:
  - TBD

### Sub-goal G-001.S-001 — First measurable increment

- Status: PLANNED
- Success criteria:
  - TBD
- Validation: TBD
- Dependencies: None
EOF
fi

if [ ! -f "$DOCS_DIR/application-map.md" ]; then
  cat > "$DOCS_DIR/application-map.md" <<'EOF'
# Verified Application Map

Record the implementation surfaces verified from code: runtime boundaries,
active routes, APIs, major models, and known gaps. This is evidence-oriented
context; it must not simply repeat roadmap aspirations.

## Audit

- Audited At: TBD
- Active frontend: TBD
- Backend/API: TBD
- Knowledge graph project: TBD

## Verified Surfaces

- TBD

## Partial or Missing Surfaces

- TBD

## Agent Rules

- Verify roadmap items against migrations, models, routes, controllers, UI, and tests.
- Update this map when an implementation surface changes.
EOF
fi

if [ ! -f "$DOCS_DIR/decisions.md" ]; then
  cat > "$DOCS_DIR/decisions.md" <<EOF
# Decision Log

## $NOW Initial AI Protocol Setup
Status: Accepted
Context: Standardized AI-readable project context was initialized.
Decision: Store shared project context under \`docs/ai/\` and automation config under \`.ai-toolkit/project.env\`.
Consequences: Any AI tool can resume work by reading repository-local context first.
EOF
fi

if [ ! -f "$DOCS_DIR/handoff.md" ]; then
  cat > "$DOCS_DIR/handoff.md" <<EOF
# Handoff Log

## $NOW Initial Setup
- Project context scaffold created.
- Next step: update \`project-context.md\` and start the first task with \`ai-start "task name"\`.
EOF
fi

if [ ! -f "$DOCS_DIR/knowledge.md" ]; then
  cat > "$DOCS_DIR/knowledge.md" <<'EOF'
# Project Knowledge Log

Record durable findings discovered during completed tasks. Include codebase,
architecture, infrastructure, CI/CD, deployment, operations, constraints,
bugs, and validation knowledge. Do not record secrets or transient debug logs.

## Entries
EOF
fi

if [ ! -f "$DOCS_DIR/next-tasks.md" ]; then
  cat > "$DOCS_DIR/next-tasks.md" <<'EOF'
# Suggested Next Tasks

No suggestions generated yet. Run ai-next after completing a task.
EOF
fi

if [ ! -f "$DOCS_DIR/operating-model.md" ]; then
  cat > "$DOCS_DIR/operating-model.md" <<'EOF'
# AI Toolkit Operating Model

## Goal

Make project work resumable across AI providers, machines, and sessions by
keeping the durable context in the repository and treating external memory as
a secondary index.

## Source of Truth

1. `docs/ai/project-context.md` — what the project is and its constraints.
2. `docs/ai/goals.md` — goal/sub-goal hierarchy and measurable outcomes.
3. `docs/ai/current-task.md` — the active objective and next step.
4. `docs/ai/handoff.md` — what the previous agent changed and validated.
5. `docs/ai/decisions.md` — durable decisions and tradeoffs.
6. `ai-state.json` — machine-readable state for agents and automation.
7. `.ai-toolkit/project.env` — local project automation settings.

**WAJIB baca juga (engine standard — berlaku semua project):**
- `~/.ai-toolkit/conventions/STANDARD_DEVELOPMENT.md` — task lifecycle (5 stage + bug hunt loop), rotasi fokus bug hunt, bukti per task, grounding rules anti-halusinasi, onboarding checklist.

Optional capabilities such as Browser MCP are configured in
`.ai-toolkit/project.env` and may be different on each machine.

## Session Lifecycle

1. `ai-init` creates or repairs the protocol.
2. An AI reads `AGENTS.md`, this document, and the current context files.
3. `ai-start` marks the active objective in Markdown and `ai-state.json`.
4. Work is implemented and validated; important decisions are recorded.
5. `ai-close` writes the handoff and updates machine-readable progress.
6. Before a completed close, the AI records durable findings with
   `ai-close --knowledge "…"`; this is written to
   `docs/ai/knowledge.md` and synchronized to Uteke when available.
7. `ai-close` generates `docs/ai/next-tasks.md` from unresolved next steps,
   risks, validation gaps, unfinished goals, and repository state.
8. `ai-commit`, `ai-push`, or `ai-deploy` performs the requested delivery step.

## Portability Rules

- Repository files are authoritative and must remain understandable without
  Uteke or any particular AI provider.
- Uteke stores concise cross-session summaries, never secrets.
- Provider-specific prompts are adapters; they must consume the same project
  context rather than create a competing state format.
- MCP endpoints are capabilities, not project state. Keep their names and
  dynamic URLs in config, and never store credentials in repository files.
- `ai-state.json` is operational metadata, not a replacement for explanation
  in Markdown.

## Goal Tracking

`goals.md` is the canonical human-readable hierarchy. Every active task
should link to one `Goal ID` and one `Sub-goal ID` in `current-task.md`.
Keep success criteria and validation evidence on the sub-goal; keep transient
execution details in `current-task.md` and `ai-state.json`.
EOF
fi

if [ ! -f "$CONFIG_FILE" ]; then
  cat > "$CONFIG_FILE" <<EOF
PROJECT_NAME="$PROJECT_NAME"
PROJECT_ROOT="$ROOT"
DEFAULT_BRANCH="$DEFAULT_BRANCH"
UTEKE_NAMESPACE="$(ai_project_slug "$ROOT")"
CODEBASE_PROJECT="$(ai_project_slug "$ROOT")"
BROWSER_MCP_ENABLED="\${BROWSER_MCP_ENABLED:-false}"
BROWSER_MCP_NAME="\${BROWSER_MCP_NAME:-browser}"
BROWSER_MCP_URL="\${BROWSER_MCP_URL:-http://127.0.0.1:9010/mcp}"
DEPLOY_DEFAULT=""
DEPLOY_STAGING=""
DEPLOY_PRODUCTION=""
POST_DEPLOY_CHECK=""
EOF
fi

# Registry sync is useful but must not prevent portable repository context from
# being initialized when the global toolkit directory is read-only or absent.
ai_sync_registry "$ROOT" 2>/dev/null || true

if git -C "$ROOT" rev-parse --show-toplevel >/dev/null 2>&1; then
  "$SCRIPT_DIR/ai-install-hooks" "$ROOT" >/dev/null
fi

echo "Initialized AI project protocol in $ROOT"
