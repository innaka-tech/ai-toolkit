#!/bin/sh
# ai-close: v1 command kept for compatibility; see scripts/_shim.sh.
. "$(dirname "$0")/_shim.sh"
if shim_is_v1; then shim_v1 ai-close "$@"; fi
# ai-close --summary S --knowledge K [--next N] [--status S]  ->  aitk close (status mapped)
set -- "$@" --end--
while [ "$1" != --end-- ]; do
  case "$1" in
    --status)
      case $(printf %s "$2" | tr "[:upper:]" "[:lower:]") in
        blocked) set -- "$@" --status blocked ;;
        active|in_progress|in-progress) set -- "$@" --status in_progress ;;
      esac
      shift 2 ;;
    --summary|--knowledge|--next) set -- "$@" "$1" "$2"; shift 2 ;;
    *) shift ;;
  esac
done
shift
shim_aitk close "$@"
