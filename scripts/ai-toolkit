#!/bin/sh
# ai-toolkit: v1 command kept for compatibility; see scripts/_shim.sh.
. "$(dirname "$0")/_shim.sh"
if shim_is_v1; then shim_v1 ai-toolkit "$@"; fi
# ai-toolkit <command> [args]: run the matching ai-<command> shim (v2 project or new repository)
cmd=${1:-help}
[ $# -gt 0 ] && shift
case "$cmd" in
  help|-h|--help) shim_aitk --help ;;
  *) if [ -x "$SHIM_DIR/ai-$cmd" ]; then exec "$SHIM_DIR/ai-$cmd" "$@"; fi
     shim_v1 ai-toolkit "$cmd" "$@" ;;
esac
