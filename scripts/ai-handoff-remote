#!/bin/bash
# ai-handoff-remote — run on JAKA (or any remote agent) to send handoff to Novara
# Usage: ssh wireguard "ai-handoff-remote novara 'task text' [--project NAME] [--scope tags]"
set -euo pipefail

TO="${1:-}"; TASK="${2:-}"
[ -z "$TO" ] && echo "Usage: ai-handoff-remote <to-agent> <task> [files]" && exit 1

TS=$(date -u +%Y%m%d%H%M%S)
TASK_ID="handoff-${TS}-${RANDOM}"
FROM="jaka"
PROJ="default"
SCOPE=""
FILES=""
shift 2 || true
while [ $# -gt 0 ]; do
  case "$1" in
    --project) PROJ="$2"; shift 2 ;;
    --scope) SCOPE="$2"; shift 2 ;;
    *) FILES="${FILES} $1"; shift ;;
  esac
done
FILES=$(echo "$FILES" | xargs)

BRIDGE="$HOME/.ai-toolkit/bridge"
LOG="$HOME/.ai-toolkit/logs/coordination-events.jsonl"
mkdir -p "$BRIDGE/inbox" "$(dirname "$LOG")"

cat > "$BRIDGE/inbox/${TASK_ID}.json" <<EOF
{
  "schema": "ai-handoff.v2",
  "task_id": "$TASK_ID",
  "from": "$FROM",
  "to": "$TO",
  "task": "$TASK",
  "files": "$FILES",
  "context_project": "$PROJ",
  "scope": "$SCOPE",
  "status": "pending",
  "created": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

printf '%s\n' "{\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"event\":\"handoff_sent\",\"task_id\":\"$TASK_ID\",\"from\":\"$FROM\",\"to\":\"$TO\",\"project\":\"$PROJ\",\"scope\":\"$SCOPE\",\"task\":\"$TASK\"}" >> "$LOG"

echo "✅ Handoff → $TO"
echo "   ID: $TASK_ID"
