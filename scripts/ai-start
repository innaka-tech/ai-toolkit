#!/bin/sh
# ai-start: v1 command kept for compatibility; see scripts/_shim.sh.
. "$(dirname "$0")/_shim.sh"
if shim_is_v1; then shim_v1 ai-start "$@"; fi
# ai-start "<task>" [--goal G] [--sub-goal S]  ->  aitk task new "<task>" --start [--goal G]
title=""
set -- "$@" --end--
while [ "$1" != --end-- ]; do
  case "$1" in
    --goal) set -- "$@" --goal "$2"; shift 2 ;;
    --sub-goal) shift 2 ;;
    *) [ -z "$title" ] && title=$1 || title="$title $1"; shift ;;
  esac
done
shift
shim_aitk task new "$title" --start "$@"
