{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/innaka-tech/ai-toolkit/main/schemas/config.schema.json",
  "title": "aitk project configuration (aitk.toml, parsed)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cmd"
      ],
      "properties": {
        "cmd": {
          "type": "string",
          "minLength": 1
        },
        "timeout": {
          "type": "string",
          "pattern": "^\\d+(s|m|h)$",
          "default": "10m"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sensitive_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Glob patterns (doublestar)"
        },
        "lite_max_files": {
          "type": "integer",
          "minimum": 0,
          "default": 3
        },
        "lite_max_lines": {
          "type": "integer",
          "minimum": 0,
          "default": 100
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget": {
          "type": "integer",
          "minimum": 500,
          "maximum": 64000,
          "default": 4000
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inbox_limit": {
          "type": "integer",
          "minimum": 1,
          "default": 20
        },
        "archive_after_days": {
          "type": "integer",
          "minimum": 1,
          "default": 90
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "post_check": {
          "type": "string"
        }
      }
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
          },
          "uniqueItems": true
        },
        "timeout": {
          "type": "string",
          "pattern": "^\\d+(ms|s)$",
          "default": "5s"
        },
        "settings": {
          "type": "object",
          "description": "Per-plugin settings, passed to the plugin in request.payload.settings",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "uat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "enum": [
            "none",
            "strict",
            "standard",
            "all"
          ],
          "default": "none",
          "description": "Profiles whose tasks need a person's acceptance (aitk uat accept) before done"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag_prefix": {
          "type": "string",
          "default": "v"
        },
        "changelog": {
          "type": "string",
          "default": "CHANGELOG.md"
        },
        "initial_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "default": "0.1.0"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asvs_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 1,
          "description": "OWASP ASVS 4.0.3 checklist required for strict tasks (0 disables)"
        },
        "audit": {
          "enum": [
            "off",
            "strict",
            "all"
          ],
          "default": "strict",
          "description": "Profiles whose Definition of Done requires a passing aitk audit"
        },
        "scanners": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "cmd"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "cmd": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "Replaces auto-detected scanners"
        }
      }
    }
  }
}
